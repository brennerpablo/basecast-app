# Copy to .env.local and fill in. Never commit it.
# Server-only: the browser never calls get-data directly (BFF pattern).
# Never prefix these with NEXT_PUBLIC_.
GET_DATA_URL=http://localhost:8000
GET_DATA_TOKEN=

# Login: every page needs a session (next-auth), with the users in Cloud SQL.
# Cloud SQL database `basecast` (the app's tables are in schema `app`) as `postgres`, through
# `cloud-sql-proxy --port 5439 basecast-509812:us-central1:basecast-pg`:
# postgresql://postgres:<Secret Manager pg-postgres-password>@127.0.0.1:5439/basecast
DATABASE_URL=
# Signs the session JWT. Secret Manager: app-nextauth-secret.
NEXTAUTH_SECRET=
# Leave unset, locally and on Vercel (next-auth v4 detects the host there).
# NEXTAUTH_URL=
# "Continue with Google": OAuth client `basecast-web` in GCP project basecast-509812. Unset, the button
# is hidden and only passwords work. Secret Manager: app-google-client-id, app-google-client-secret.
# Redirect URIs registered: http://localhost:3000 and https://basecast.pbrenner.com, + /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel only (no cloud-sql-proxy there): the connector opens the tunnel as the service account in
# GCP_SA_KEY (JSON key of app-vercel, role cloudsql.client); DATABASE_URL's host is then ignored.
# CLOUD_SQL_INSTANCE=basecast-509812:us-central1:basecast-pg
# GCP_SA_KEY=

# Email (Resend). A sending-only key, restricted to the domain basecast.pbrenner.com.
# Secret Manager: app-resend-api-key. Only code that sends email reads it; `npm run email:test` checks it.
RESEND_API_KEY=
