// Tables the app owns, in the `basecast` database (Cloud SQL), apart from the pipelines' tables in
// `public`, so `prisma db push` never sees those: the login users and their photos in `app`, and the
// log every service writes in `ops`. Applied with `npm run db:push`; there is no migration history.
// The grants that let the pipelines (and later the API) write `ops.log` are in `prisma/ops-grants.sql`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "ops"]
}

model User {
  id           String      @id @default(cuid())
  /// Lowercase, no "@" (see `USERNAME_PATTERN`), so a sign-in identifier with "@" is always an email.
  username     String      @unique
  /// Lowercase.
  email        String      @unique
  name         String?
  /// bcrypt. Null for users who only sign in with Google.
  passwordHash String?
  /// Google's `sub`, set on the first "Continue with Google" (`src/lib/auth/google-user.ts`).
  googleId     String?     @unique
  /// The Google photo, refreshed on each Google sign-in; an uploaded `avatar` takes its place.
  imageUrl     String?
  isSuperAdmin Boolean     @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  avatar       UserAvatar?

  @@schema("app")
}

/// The photo a user uploads on /account: a 256×256 crop made in the browser, a few dozen KB. A table
/// of its own so reading a user (sign-in, the token refresh after an edit) never hauls the bytes.
model UserAvatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PNG, JPEG or WebP, checked by its magic bytes (`sniffImageType`).
  bytes       Bytes
  contentType String
  /// Goes into the photo's URL (`?v=`), so a new upload is never hidden by the browser cache.
  updatedAt   DateTime @updatedAt

  @@schema("app")
}

/// The one log of BaseCast: app, get-data and airflow write the same row shape here, and /ops reads
/// it. The format is the contract in basecast-get-data `docs/data-contract.md` ("ops.log"); columns
/// are snake_case because the Python services insert with plain SQL. Rows are info and above; debug
/// stays on stdout. Kept 30 days.
model OpsLog {
  id          BigInt   @id @default(autoincrement())
  /// When it happened, UTC.
  ts          DateTime @default(now()) @db.Timestamptz(3)
  /// `app` | `get-data` | `airflow`.
  service     String
  /// `production` | `preview` | `development`.
  env         String
  /// `info` | `warn` | `error`.
  level       String
  /// Stable dotted name: `http.request`, `server.error`, `auth.sign_in`, `etl_run.failed`…
  event       String
  message     String
  /// One user action, from the app's BFF down to get-data (`x-request-id`).
  requestId   String?  @map("request_id")
  /// `etl_run.run_id`, on every line of a pipeline run.
  runId       String?  @map("run_id")
  userId      String?  @map("user_id")
  method      String?
  /// The route template (`/api/accounts/:id`), never the raw URL or its query string.
  route       String?
  status      Int?
  durationMs  Int?     @map("duration_ms")
  errorClass  String?  @map("error_class")
  /// At most 15 lines.
  errorStack  String?  @map("error_stack")
  /// `service:error_class:route-or-source`, to group the same error.
  fingerprint String?
  /// Commit or revision that produced the line.
  version     String?
  /// Vercel region, Cloud Run instance or machine.
  host        String?
  /// Everything else, scrubbed of secrets.
  context     Json?

  @@index([ts(sort: Desc)])
  @@index([service, ts(sort: Desc)])
  @@index([event, ts(sort: Desc)])
  @@index([requestId])
  @@index([runId])
  @@index([fingerprint, ts(sort: Desc)])
  @@map("log")
  @@schema("ops")
}
