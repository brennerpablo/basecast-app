// Tables the app owns: the login users and their photos. They live in the `app` schema
// of the `basecast` database (Cloud SQL), apart from the pipelines' tables in `public`, so
// `prisma db push` never sees those. Applied with `npm run db:push`; there is no migration history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model User {
  id           String      @id @default(cuid())
  /// Lowercase, no "@" (see `USERNAME_PATTERN`), so a sign-in identifier with "@" is always an email.
  username     String      @unique
  /// Lowercase.
  email        String      @unique
  name         String?
  /// bcrypt.
  passwordHash String
  isSuperAdmin Boolean     @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  avatar       UserAvatar?

  @@schema("app")
}

/// The photo a user uploads on /account: a 256×256 crop made in the browser, a few dozen KB. A table
/// of its own so reading a user (sign-in, the token refresh after an edit) never hauls the bytes.
model UserAvatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PNG, JPEG or WebP, checked by its magic bytes (`sniffImageType`).
  bytes       Bytes
  contentType String
  /// Goes into the photo's URL (`?v=`), so a new upload is never hidden by the browser cache.
  updatedAt   DateTime @updatedAt

  @@schema("app")
}
